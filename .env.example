# =========================================================
# Configuracion del Bot toDus + IA
# Copia este archivo a .env y completa los valores
# =========================================================

# --- Cuenta toDus del BOT ---
# Numero de telefono en formato internacional sin + ni espacios
# Ej: 5312345678  (Cuba)  |  5491130001111 (Argentina)
TODUS_PHONE=5300000000
# Contrasena de la cuenta toDus (no el codigo SMS, la password fija)
TODUS_PASSWORD=tu_password_aqui

# --- Owner / Administrador ---
# Telefono del dueno del bot (sin + ni espacios). Tendra privilegios:
# - Respuestas ilimitadas (sin rate-limit)
# - Recibe respuestas en privado siempre
OWNER_PHONE=54309042

# --- API de IA (compatible OpenAI) ---
AI_API_BASE=https://vimax-ia.p.jo3.org/v1
AI_API_KEY=sk--f8JuT4hCbGIOSYK5xZk7dwkTLMyVnLqQob2Yb5Wo1Q
# Modelo mas rapido de Gemini disponible en tu API
AI_MODEL=gemini-3.5-flash-lite

# --- Comportamiento humano ---
# Mostrar "escribiendo..." antes de responder
HUMAN_TYPING=true
# Delay minimo antes de responder (segundos) - simula lectura
HUMAN_MIN_DELAY=0.8
# Editar el mensaje en streaming (mostrar progreso de la IA)
HUMAN_STREAM_EDIT=true
# Cada cuantos caracteres editar el mensaje (para streaming)
HUMAN_EDIT_INTERVAL=180
# Enviar presencia "en linea" (punto verde)
HUMAN_ONLINE=true

# --- Rate limits ---
# Limite para usuarios normales en PRIVADO (peticiones por minuto)
LIMIT_PRIVATE=5
# Limite para usuarios normales en GRUPO (peticiones por minuto)
LIMIT_GROUP=10

# --- Memoria ---
# Maximo mensajes guardados por usuario (para no inflar contexto)
MEMORY_MAX_MESSAGES=20
# Path a la base SQLite (relativo al directorio del bot)
MEMORY_DB=data/memory.db

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
